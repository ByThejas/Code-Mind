# Copy to .env and adjust. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://codemind:local_password_change_me@localhost:5432/codemind
REDIS_URL=redis://localhost:6379/0

# Optional read-only GitHub token. Public repositories work without it, but GitHub then allows
# only 60 API requests an hour.
GITHUB_TOKEN=

# Ingestion limits
MAX_REPOSITORY_FILES=20000
MAX_FILE_BYTES=1000000
MAX_INDEX_BYTES=500000000
MAX_JOB_SECONDS=1800
JOB_HEARTBEAT_SECONDS=30
JOB_STALE_SECONDS=300

# Retrieval and answers with free local models served by Ollama (https://ollama.com). No API keys.
# Pull them once: ollama pull bge-m3 && ollama pull qwen2.5-coder:7b
# Use "none" to run without models: keyword and symbol search still work.
OLLAMA_URL=http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_CONTEXT_TOKENS=16384
ANSWER_CONTEXT_TOKENS=8000
